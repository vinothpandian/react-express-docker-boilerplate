{
  "name": "react-express-docker-boilerplate",
  "version": "1.0.0",
  "description": "Boilerplate for React-Express app with testing framework and Docker integration",
  "main": "src/server/app.js",
  "scripts": {
    "start": "npm run build:prod && npm run serve",
    "serve": "node dist/server/app.cjs",
    "dev": "npm run build:prod && concurrently -k \"npm run build:client:dev\" \"npm run build:server:dev\" \"node --watch dist/server/app.cjs\"",
    "dev:client": "vite --port 8081",
    "build:prod": "npm run build:server && npm run build:client",
    "build:client": "vite build",
    "build:client:dev": "vite build --watch",
    "build:server": "node build-server.cjs",
    "build:server:dev": "node build-server.cjs --watch",
    "test": "vitest run --coverage && npm run standard",
    "test:watch": "vitest",
    "standard": "biome lint src",
    "standard:fix": "biome lint --write src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MisaOgura/react-express-docker-boilerplate.git"
  },
  "keywords": [
    "javascript",
    "react",
    "es6",
    "express",
    "webpack",
    "babel",
    "docker",
    "jest"
  ],
  "author": "Misa Ogura",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MisaOgura/react-express-docker-boilerplate/issues"
  },
  "homepage": "https://github.com/MisaOgura/react-express-docker-boilerplate#readme",
  "dependencies": {
    "express": "^4.22.3",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-redux": "^5.0.6",
    "redux": "^3.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^12.1.5",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^28.1.0",
    "supertest": "^7.2.0",
    "vite": "^8.2.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
